package com.tp.gestiondepenses;

import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.TextView;
import androidx.appcompat.app.AppCompatActivity;
import androidx.recyclerview.widget.LinearLayoutManager;
import androidx.recyclerview.widget.RecyclerView;
import com.google.android.material.floatingactionbutton.FloatingActionButton;
import java.util.ArrayList;

public class HomeActivity extends AppCompatActivity {

    private TextView tvSolde, tvRevenus, tvDepenses, tvMonth, tvEmpty;
    private RecyclerView rvTransactions;
    private Button btnAddFirst;
    private FloatingActionButton fabAdd;  // Récupère le FAB depuis activity_home.xml

    private TransactionAdapter adapter;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_home);

        // Récupération des vues (elles sont dans content_home.xml)
        tvSolde = findViewById(R.id.tv_solde);
        tvRevenus = findViewById(R.id.tv_revenus);
        tvDepenses = findViewById(R.id.tv_depenses);
        tvMonth = findViewById(R.id.tv_month);
        rvTransactions = findViewById(R.id.rv_transactions);
        tvEmpty = findViewById(R.id.tv_empty);
        btnAddFirst = findViewById(R.id.btn_add_first);
        fabAdd = findViewById(R.id.fab_add);  // Assurez-vous que activity_home.xml contient un FAB avec cet id

        // Adaptateur avec liste vide
        adapter = new TransactionAdapter(new ArrayList<>());
        rvTransactions.setLayoutManager(new LinearLayoutManager(this));
        rvTransactions.setAdapter(adapter);

        // Données fictives pour le solde (à remplacer plus tard)
        afficherDonneesFictives();

        // Masquer le RecyclerView car aucune transaction
        rvTransactions.setVisibility(View.GONE);
        tvEmpty.setVisibility(View.VISIBLE);
        btnAddFirst.setVisibility(View.VISIBLE);

        // Actions (plus tard vous ouvrirez le formulaire d'ajout)
        fabAdd.setOnClickListener(v -> {
            // Exemple : startActivity(new Intent(this, DepenseActivity.class));
        });
        btnAddFirst.setOnClickListener(v -> {
            // Exemple : startActivity(new Intent(this, DepenseActivity.class));
        });
    }

    private void afficherDonneesFictives() {
        double revenus = 0.0;
        double depenses = 0.0;
        double solde = revenus - depenses;

        tvSolde.setText(String.format("%.2f €", solde));
        tvRevenus.setText(String.format("⭐ Revenus: %.2f €", revenus));
        tvDepenses.setText(String.format("🚫 Dépenses: %.2f €", depenses));
        tvMonth.setText("mai 2026");
    }
}